# Final Day 7 evaluated model: Gemini 3.5 Flash-Lite. Store the real key only in local .env.
# Historical CP3–CP7 benchmarking used 3.5 Flash-Lite and is labeled as such.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=75
# Keep database credentials in Lab 6's starter/.env or environment only.
# DATABASE_URL is optional if Day 6 starter/.env exists.
