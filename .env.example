# Copy to .env locally. Never commit real keys, tokens or DB passwords.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Google lists 3.5 Flash-Lite as supporting native function calling.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=75
# DATABASE_URL can be omitted: CP3 reuses Lab 6 starter/.env read-only.
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:55433/day6_lab
